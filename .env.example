# Copy to .env and replace BASE_URL with your UAT portal URL.
TEST_ENV=uat
BANK=demo
LOCALE=en-in
BASE_URL=__REQUIRED__
# Set only when encrypted test data is used.
# TEST_DATA_ENCRYPTION_KEY=
# Set only when an approved API endpoint is needed.
# API_BASE_URL=
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# Optional saved session for authenticated cases. Leave unset for login/session tests.
# AUTH_STATE=auth/uat/demo/en-in/customer.json
